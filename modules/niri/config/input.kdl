// https://niri-wm.github.io/niri/Configuration:-Input

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:caps_toggle,shift:capital_capslock"
        }
    }

    touchpad {
        tap
        dwt        // experimental
        drag-lock  // experimental
        natural-scroll
        accel-speed 0.1
        scroll-factor 0.3
    }

    mouse {
        accel-speed -0.2
    }

    // warp-mouse-to-focus
    focus-follows-mouse
}
